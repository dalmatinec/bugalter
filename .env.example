# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID владельцев через запятую, например 111111111,222222222 (свой ID покажет @userinfobot)
OWNER_TELEGRAM_IDS=
# Пароль базы: только латиница и цифры (он подставляется в URL подключения)
POSTGRES_PASSWORD=
POSTGRES_USER=bugalter
POSTGRES_DB=bugalter
# Прокси до Telegram, только если сервер не видит api.telegram.org: http://user:pass@host:port
TELEGRAM_PROXY=
LOG_LEVEL=INFO
LOG_JSON=true
# Резервные копии в папке backups: сколько последних хранить и как часто (28800 секунд = каждые 8 часов, 3 раза в сутки)
BACKUP_KEEP=3
BACKUP_INTERVAL_SECONDS=28800
