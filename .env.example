# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID владельцев через запятую (узнать свой ID: написать боту /id после запуска или @userinfobot)
OWNER_TELEGRAM_IDS=
# Пароль базы: только латиница и цифры (он подставляется в URL подключения)
POSTGRES_PASSWORD=
POSTGRES_USER=bugalter
POSTGRES_DB=bugalter
# Прокси до Telegram, только если сервер не видит api.telegram.org: http://user:pass@host:port
TELEGRAM_PROXY=
LOG_LEVEL=INFO
LOG_JSON=true
# Резервные копии: хранить дней, интервал в секундах (86400 = раз в сутки)
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
